{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Stores core profile information for a user.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "defaultModeId": { "type": "string" }
      },
      "required": ["id", "email", "role", "createdAt", "lastSeen", "defaultModeId"]
    },
    "Insight": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Insight",
      "type": "object",
      "description": "A global intelligence observation dispatched to the network stream.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "user": { "type": "string" },
        "avatar": { "type": "string" },
        "text": { "type": "string" },
        "isLive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "user", "text", "createdAt"]
    },
    "UserPreference": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserPreference",
      "type": "object",
      "description": "User-specific display and interaction preferences.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "schemaVersion": { "type": "string" },
        "density": { "type": "string" },
        "motion": { "type": "string" },
        "contrast": { "type": "string" },
        "fontScaling": { "type": "number" }
      },
      "required": ["id", "userId", "schemaVersion", "density", "motion", "contrast", "fontScaling"]
    },
    "UserLayout": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserLayout",
      "type": "object",
      "description": "Personalized dashboard layout.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "schemaVersion": { "type": "string" },
        "modeId": { "type": "string" },
        "lastMigratedAt": { "type": "string", "format": "date-time" },
        "gridConfigurationJson": { "type": "string" }
      },
      "required": ["id", "userId", "schemaVersion", "modeId", "lastMigratedAt", "gridConfigurationJson"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": { "$ref": "#/backend/entities/UserProfile" },
          "description": "Root user profiles."
        }
      },
      {
        "path": "/insights/{insightId}",
        "definition": {
          "entityName": "Insight",
          "schema": { "$ref": "#/backend/entities/Insight" },
          "description": "Global social intelligence stream."
        }
      },
      {
        "path": "/users/{userId}/preferences/{preferenceId}",
        "definition": {
          "entityName": "UserPreference",
          "schema": { "$ref": "#/backend/entities/UserPreference" },
          "description": "User specific preferences."
        }
      },
      {
        "path": "/users/{userId}/layouts/{layoutId}",
        "definition": {
          "entityName": "UserLayout",
          "schema": { "$ref": "#/backend/entities/UserLayout" },
          "description": "Dashboard layouts."
        }
      }
    ]
  }
}